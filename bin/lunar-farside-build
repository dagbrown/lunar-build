#!/bin/bash

mkdir -p ~/logs

exec > ~/logs/build.$(date +%Y%m%d.%H).log 2>&1

NAME=farside
FULLNAME="Gagarin" # It's the name of a crater on the far side, also the first man in space
MOONBASE=default
UPDATE=false

while true
do
    if [ $# -ge 0 ]
    then
        case "$1" in
            -n|--name)
                shift
                NAME=$1
                shift
                continue
            ;;

            -f|--full-name)
                shift
                FULLNAME="$1"
                shift
                continue
            ;;

            -m|--moonbase)
                shift
                MOONBASE_URL="$1"
                shift
                continue
            ;;

            -u|--update)
                shift
                UPDATE=true
                continue
            ;;

            *)
                break
            ;;
        esac
    fi
done

if [ $1 ]
then
    NAME="$1"
fi

echo "Build started at $(date)"

PATH=/sbin:/bin:/usr/sbin:/usr/bin:.
export PATH

if [[ "${MOONBASE:-default}" != default ]]
then
    lunar set MOONBASE_URL $MOONBASE
    lin moonbase
    if $UPDATE
    then
        lunar renew
    fi
fi

[[ -d lunar-iso ]] && sudo rm -rf lunar-iso

git clone git@gitlab.lart.ca:dagbrown/lunar-iso.git

cd lunar-iso

git checkout farside

corecount=$(grep processor /proc/cpuinfo | wc -l)
makecount=$[corecount*2]

cat >> conf/config << EOT
ISO_ARCH = $(arch)
ISO_MAJOR = 2.0.0
ISO_DATE = $(date +%Y%m%d)

# change this to taste
ISO_MINOR = $(date +${NAME}-%Y%m%d.%H)

ifeq (,\$(ISO_MINOR))
  ISO_VERSION = \$(ISO_MAJOR)-\$(ISO_ARCH)
else
  ISO_VERSION = \$(ISO_MAJOR)-\$(ISO_MINOR)-\$(ISO_ARCH)
endif

ISO_CODENAME = $FULLNAME

ISO_BUILD = \$(ISO_ARCH)-pc-linux-gnu

ISO_CNAME = \$(ISO_VERSION) (\$(ISO_CODENAME) - \$(ISO_DATE))

ISO_LABEL = \$(shell echo -n Lunar-Linux \$(ISO_CODENAME) | tr '[:space:]' _)

ISO_LUNAR_MODULE = lunar

ISO_MAKES = ${makecount}

ISO_GCCARCH = $(arch)
EOT

# ----------------------------------------------------------------------
# a parade of bodges for the farside build
# ----------------------------------------------------------------------
sudo make stage1
sudo make stage2-moonbase

# "m4" and "libunistring" don't get installed at the right time so force
# install them first
sudo ISO_TARGET=$(cd BUILD && pwd) scripts/chroot-build lin m4
sudo ISO_TARGET=$(cd BUILD && pwd) scripts/chroot-build lin libunistring
sudo make stage2

# grub2 gets trashed by the kernel build probably because of zfs, so
# grab the stage2 cache to rescue the good grub2 from it
cp -r BUILD/var/cache/lunar cache.stage2
sudo make kernel
cp cache.stage2/grub2* BUILD/var/cache/lunar
sudo make

echo "Build finished at $(date)"

if [ -f *.iso ]
then
    for i in *.iso
    do
        sha256sum $i > ${i}.sha256
    done
    if [ -d ~/iso ]
    then
        cp -v $i ${i}.sha256 ~/iso
        if [ -f /.dockerenv ] && # running in a container?
           [ "$(cat /proc/1/cmdline)" == "/usr/lib/systemd/systemd" ]
        then
            # shut down the container to free up tmpfs memory
            sudo systemctl poweroff
        fi
    fi
fi

echo "ISO finished at $(date)"
